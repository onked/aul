loc t = {}
for (loc i = 1; i <= 10; i = i + 1) {
    t[i] = i
}
loc sum = 0
for (_, v in t) {
    sum = sum + v
}
if (sum == 55) { print("ok 12") } else { print("FAIL 12") }
if (#t == 10) { print("ok 13") } else { print("FAIL 13") }


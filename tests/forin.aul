glo items = {1: "apple", 2: "banana", 3: "cherry"}
for (_, item in items) {
    print(item)
}
for (k, v in items) {
    print(k)
    print(v)
}
glo one = {1: "only"}
for (v in one) {
    print(v)
}
glo sums = {5: "five", 2: "two", 7: "seven"}
for (k, v in sums) {
    print(k)
    print(v)
}
glo total = 0
for (_, n in {1: 10, 2: 20, 3: 30}) {
    total = total + n
}
print(total)
for (k, v in {}) {
    print(k)
}
print("end")
glo kept = 0
for (k, v in items) {
    if (k == 2) {
        continue
    }
    kept = kept + 1
    if (k == 3) {
        break
    }
}
print(kept)